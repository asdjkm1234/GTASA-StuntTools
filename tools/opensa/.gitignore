# Everything under static/ is generated from a local GTA copy and gitignored: the built game archives
# (npm run build:game). No Rockstar assets are committed.
/static/
/game-src/
/mods-src/
/issues/
/blog-src/
/tutors-src/
/NO_COMMIT/
# Test fixtures — NOTHING under fixtures/ is committed (the user's call, 2026-08-17). `npm run test:fixtures`
# rebuilds all of it locally: fixtures/original/ + fixtures/viewer/ from the stock install at game-src/original
# (Rockstar assets, never redistributed) and fixtures/custom/ as a mirror of fixtures-src/ — the curated,
# version-pinned, mod-derived and golden-snapshot files that have NO other source (kept local, backed up
# by hand). A tree without fixtures-src/ runs the suite with those tests skipped (`skipIf(!existsSync)`).
/fixtures/
/fixtures-src/

# Nx cache
.nx/
public/
