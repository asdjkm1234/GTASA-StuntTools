{
  "name": "opensa",
  "version": "0.4.0",
  "description": "An open-source, from-scratch game engine built compatible with RenderWare (the GTA San Andreas engine) — runs SA assets and mods in the browser (DFF/TXD/COL/IMG, IPL/IDE world streaming) with Rapier physics.",
  "keywords": [
    "opensa",
    "gta",
    "gta-san-andreas",
    "san-andreas",
    "renderware",
    "dff",
    "txd",
    "col",
    "img-archive",
    "ipl",
    "ide",
    "webgpu",
    "typescript",
    "rapier",
    "game-engine",
    "renderware-engine",
    "total-conversion",
    "mods",
    "browser"
  ],
  "homepage": "https://opensa.cc",
  "bugs": {
    "url": "https://github.com/AlexSergey/opensa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexSergey/opensa.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Aleksandrov Sergey <gooddev.sergey@gmail.com>",
  "workspaces": [
    "apps/web",
    "apps/viewer",
    "apps/engine-lab",
    "apps/sa-map-viewer",
    "apps/cutscene-converter",
    "packages/cell-weld",
    "packages/cleo",
    "tools/rw-codec",
    "tools/tool-kit",
    "tools/add-vehicles",
    "packages/renderware",
    "packages/game-build",
    "packages/loaders",
    "packages/vfs",
    "packages/game",
    "packages/engine-formats",
    "packages/engine",
    "packages/math",
    "packages/validation",
    "tools/map-optimizer",
    "tools/opensa-lod-generator",
    "tools/vehicle-optimizer",
    "tools/timecyc-builder",
    "tools/lod-trees-generator",
    "tools/map-placement",
    "tools/lod-common",
    "tools/sa-lod-generator",
    "tools/perfect-map-builder",
    "tools/sa-procobj-placement",
    "tools/img-splitter",
    "tools/mod-installer",
    "tools/vehicle-installer",
    "tools/vehicle-cutscene",
    "tools/ped-installer",
    "tools/opensa-pack",
    "tools-debug/sa-int16-repro",
    "asi/perfect-cutscene",
    "asi/perfect-map",
    "asi/perfect-vehicle",
    "asi/sdk",
    "cleo/sdk"
  ],
  "scripts": {
    "arch": "tsx scripts/arch-graph.ts",
    "arch:render": "tsx scripts/arch-graph.ts --svg docs/architecture/assets/packages.svg && tsx scripts/arch-graph.ts --layers app,engine --svg docs/architecture/assets/runtime-packages.svg && tsx scripts/arch-graph.ts --render docs/architecture",
    "build": "tsc -b && vite build",
    "build:cleo-scripts": "tsx cleo/sdk/src/cli.ts",
    "build:embed:dispatch": "vite build --config apps/dispatch/vite.lib.config.ts",
    "build:game:anderius:opensa": "NODE_OPTIONS=--max-old-space-size=12288 tsx tools/perfect-map-builder/src/cli.ts --game ./game-src/anderius --in ./mods-src/anderius --out ./build/anderius --exclude sa && tsx tools/fetch-pack/src/cli.ts --build ./build/anderius",
    "build:game:carcer:opensa": "NODE_OPTIONS=--max-old-space-size=12288 tsx tools/perfect-map-builder/src/cli.ts --game ./game-src/carcer --in ./mods-src/carcer --out ./build/carcer --exclude sa && tsx tools/fetch-pack/src/cli.ts --build ./build/carcer",
    "build:game:gostown:opensa": "NODE_OPTIONS=--max-old-space-size=12288 tsx tools/perfect-map-builder/src/cli.ts --game ./game-src/gostown --in ./mods-src/gostown --out ./build/gostown --exclude sa && tsx tools/fetch-pack/src/cli.ts --build ./build/gostown",
    "build:game:original:opensa": "NODE_OPTIONS=--max-old-space-size=12288 tsx tools/perfect-map-builder/src/cli.ts --game ./game-src/original --in ./mods-src/original --out ./build/original --exclude sa && tsx tools/fetch-pack/src/cli.ts --build ./build/original",
    "build:game:original:sa": "NODE_OPTIONS=--max-old-space-size=12288 tsx tools/perfect-map-builder/src/cli.ts --game ./game-src/original --in ./mods-src/original --out ./build/original --exclude opensa",
    "build:prod": "tsc -b && OPENSA_NO_VIEWERS=true OPENSA_DEBUGGER_HIDE=true vite build",
    "build:share:dispatch": "vite build --config apps/dispatch/vite.share.config.ts",
    "cars": "tsx scripts/cars-server/src/server.ts",
    "cars:opensa": "tsx scripts/cars-server/src/server.ts --target opensa",
    "cars:sa": "tsx scripts/cars-server/src/server.ts --target sa",
    "cleo:opcodes": "tsx packages/cleo/scripts/generate-opcodes.ts",
    "cleo:whitelist": "tsx cleo/sdk/scripts/generate-whitelist.ts",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "format": "npm run format:prettier && npm run format:code",
    "format:code": "eslint . --fix",
    "format:prettier": "prettier --write \"src/**/*.{ts,json}\"",
    "knip": "knip",
    "lint": "npm run lint:ts && npm run lint:code",
    "lint:code": "eslint .",
    "lint:commit": "commitlint --config .commitlintrc.cjs --edit",
    "lint:ts": "tsc --noEmit",
    "panel": "node tools-debug/phone-console/server.mjs",
    "panel:mcp": "node tools-debug/phone-console/mcp.mjs",
    "panel:tunnel": "node tools-debug/phone-console/tunnel.mjs",
    "phone": "bash scripts/phone.sh",
    "phone:setup": "bash scripts/phone-setup.sh",
    "pre-commit": "lint-staged --config .lintstagedrc.cjs",
    "prepare": "husky || true",
    "preview": "vite preview",
    "release": "release-it",
    "serve:static": "tsx scripts/serve-static.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fixtures": "tsx scripts/test-fixtures.ts && tsx scripts/test-viewer-fixtures.ts",
    "test:watch": "vitest",
    "timecyc": "tsx ./tools/timecyc-builder/src/index.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "astc-encoder.js": "1.0.0",
    "bitecs": "0.4.0",
    "fflate": "0.8.3",
    "meshoptimizer": "1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.0.1",
    "@commitlint/config-conventional": "21.0.1",
    "@eslint-react/eslint-plugin": "5.7.8",
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@inquirer/checkbox": "5.1.5",
    "@inquirer/prompts": "8.4.3",
    "@nx/eslint-plugin": "23.0.1",
    "@playwright/test": "1.60.0",
    "@release-it/bumper": "7.0.5",
    "@release-it/conventional-changelog": "11.0.0",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "5.0.6",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser-playwright": "4.1.6",
    "@vitest/coverage-v8": "4.1.6",
    "@webgpu/types": "0.1.71",
    "eslint": "10.3.0",
    "eslint-config-flat-gitignore": "2.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-import-lite": "0.6.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-package-json": "0.91.2",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-regexp": "3.1.0",
    "eslint-plugin-sonarjs": "4.0.3",
    "eslint-plugin-storybook": "10.4.0",
    "eslint-plugin-unicorn": "64.0.0",
    "express": "5.2.1",
    "globals": "17.6.0",
    "handlebars": "4.7.9",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.13.1",
    "lint-staged": "17.0.4",
    "mermaid": "11.16.0",
    "nx": "23.0.1",
    "playwright": "1.60.0",
    "prettier": "3.8.3",
    "react-doctor": "0.1.6",
    "release-it": "20.0.1",
    "sirv": "3.0.2",
    "stylelint": "16.13.2",
    "stylelint-config-standard": "36.0.1",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "vite-plugin-istanbul": "8.0.0",
    "vitest": "4.1.6"
  },
  "allowScripts": {
    "electron@43.4.0": true
  }
}
